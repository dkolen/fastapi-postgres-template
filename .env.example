# --- App ---
APP_NAME=fastapi-postgres-template
ENVIRONMENT=local
LOG_LEVEL=INFO
API_PORT=8000

# --- Postgres ---
# When using the full stack (docker-compose.yml) POSTGRES_HOST/PORT are overridden
# to point at the bundled "db" container. For API-only mode, point these at your
# own Postgres server. Use host.docker.internal to reach a server on your machine.
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app

# Startup connection attempts before the app gives up and exits
DB_CONNECT_RETRIES=5
DB_CONNECT_RETRY_DELAY_SECONDS=2

# Hot-reload on code changes (local dev). Keep false if you need the container
# to exit when startup fails.
RELOAD=false
